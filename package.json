{
  "name": "firstlook",
  "version": "1.0.0",
  "private": true,
  "description": "FirstLook — tax-sale deal screener MVP for real estate investors",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "research": "tsx src-cli/index.ts",
    "research:sheets": "tsx src-cli/index.ts --sheets",
    "typecheck": "tsc --noEmit",
    "qa": "tsx scripts/qa.ts",
    "prebuild": "npm run qa && npm run qa:routes && npm audit --audit-level=high",
    "qa:routes": "tsx scripts/qa-routes.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "csv-parse": "7.0.2",
    "csv-stringify": "^6.5.2",
    "dotenv": "^16.4.7",
    "next": "15.5.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.24.2",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "@types/pg": "^8.11.11"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
