# Optional — without these keys the agent still runs using public Census Geocoder
# + Census Reporter ACS enrichment, and writes a Google-Sheets-compatible CSV.

# Optional direct Census Data API key (fallback if Census Reporter is down)
CENSUS_API_KEY=

# OpenAI / Claude / Gemini (optional Phase 1 notes generation)
LLM_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional Google Sheets upload
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# County defaults for Phase 1 sample
DEFAULT_STATE=GA
DEFAULT_COUNTY=Clayton
DEFAULT_CITY=Jonesboro
